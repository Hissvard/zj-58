name: build-mac
on: workflow_dispatch

jobs:
  build:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4

      - name: Build
        run: |
          mkdir build && cd build
          cmake -DCMAKE_OSX_ARCHITECTURES="arm64;x86_64" -DCMAKE_OSX_DEPLOYMENT_TARGET=11.0 ..
          cmake --build .
          sudo make install DESTDIR=$PWD/stage
          echo "=== FILE PRODOTTI ==="
          find stage -type f
          cd stage && sudo tar -czf $GITHUB_WORKSPACE/zj58-mac.tar.gz .

      - uses: actions/upload-artifact@v4
        with:
          name: zj58-mac
          path: zj58-mac.tar.gz
